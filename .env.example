# Supabase — Project Settings → API (restart `npm run dev` after changes)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Anon or publishable key: legacy JWT (eyJ…) or new publishable key (sb_pub… / sb_publishable_…)
VITE_SUPABASE_ANON_KEY=your-anon-key

# Supabase Auth → URL Configuration (password reset redirect):
# Site URL: https://suppliersync.org
# Redirect URLs: https://suppliersync.org/reset-password
#                 http://localhost:5173/reset-password

# Stripe — primary checkout uses create-checkout-session edge function (org metadata).
# Run: ./scripts/setup-stripe-webhook.sh
# Supabase Edge Function secrets (not Vite):
#   STRIPE_SECRET_KEY=sk_test_...
#   STRIPE_WEBHOOK_SECRET=whsec_...
#   STRIPE_PRICE_CHARTER=price_...   ($49/mo charter partner)
#   STRIPE_PRICE_FOUNDING=price_...  ($79/mo founding clinic)
#   STRIPE_PRICE_STANDARD=price_...  ($119/mo standard)
# Webhook URL: https://YOUR-PROJECT.supabase.co/functions/v1/stripe-webhook
# Events: checkout.session.completed, customer.subscription.updated,
#         customer.subscription.deleted, invoice.payment_failed

# Optional fallback Payment Links (static — cannot pass organization_id per checkout):
VITE_STRIPE_LINK_CHARTER=https://buy.stripe.com/your-charter-link
VITE_STRIPE_LINK_FOUNDING=https://buy.stripe.com/your-founding-link
VITE_STRIPE_LINK_STANDARD=https://buy.stripe.com/your-standard-link

# Optional legacy static portal URL — prefer create-portal-session edge function
VITE_STRIPE_CUSTOMER_PORTAL_URL=https://billing.stripe.com/p/login/your-portal

# Legacy (optional — not used if founding + standard are set)
# VITE_STRIPE_LINK_STARTER=
# VITE_STRIPE_LINK_PRO=
# VITE_STRIPE_LINK_BUSINESS=

# Renewal email reminders (Supabase Edge Function secrets — not Vite env)
# See supabase/RENEWAL_EMAIL_SETUP.md
# RESEND_API_KEY=
# RENEWAL_FROM_EMAIL=SupplierSync <renewals@yourdomain.com>
# APP_URL=https://suppliersync.org
# CRON_SECRET=

# Founder signup notifications (Supabase Edge Function secrets — not Vite env)
# Run: ./scripts/setup-signup-notify.sh
# FOUNDER_NOTIFY_EMAIL=addstero28@gmail.com
# SIGNUP_WEBHOOK_SECRET=
# SIGNUP_FROM_EMAIL=SupplierSync <notifications@yourdomain.com>

# Founding application notifications (Supabase Edge Function secrets — not Vite env)
# Run: ./scripts/setup-founding-notify.sh
# See supabase/FOUNDING_CLINICS.md
# FOUNDING_WEBHOOK_SECRET=

# AI contract extraction (Supabase Edge Function secrets — not Vite env)
# Run: ./scripts/setup-contract-extract.sh
# OPENAI_API_KEY=
